# Unload the macOS WindowManager process
# launchctl unload -F /System/Library/LaunchAgents/com.apple.WindowManager.plist > /dev/null 2>&1 &

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

$HOME/.config/yabai/spaces.sh

# yabai -m config external_bar                all:40:0

# Layout
yabai -m config layout                      bsp
yabai -m config split_ratio                 0.50
yabai -m config auto_balance                off

# Mouse
yabai -m config mouse_follows_focus         on
yabai -m config focus_follows_mouse         autofocus
yabai -m config mouse_modifier              cmd + fn
yabai -m config mouse_action1               move
yabai -m config mouse_action2               resize
yabai -m config mouse_drop_action           swap
yabai -m config insert_feedback_color       0xddee3333

# Windows
yabai -m config window_shadow               float
yabai -m config window_zoom_persist         off
yabai -m config window_placement            second_child

# Opacity
yabai -m config window_opacity              on
yabai -m config window_opacity_duration     0.0
yabai -m config active_window_opacity       1.0
yabai -m config normal_window_opacity       1.0


# Padding
yabai -m config top_padding                 0
yabai -m config bottom_padding              0
yabai -m config left_padding                0
yabai -m config right_padding               0
yabai -m config window_gap                  2

# App configs
yabai -m rule --add app="Slack" space=1
yabai -m rule --add app="Google Chrome Dev" space=2
yabai -m rule --add app="Alacritty" space=3

# Disable specific apps
yabai -m rule --add app="^(System Settings|System Information|Activity Monitor|Screen Sharing|Calculator|Stickies|TinkerTool|Progressive Downloader|Transmission|Airflow)$" manage=off

borders active_color=0xff89dceb inactive_color=0x00000000 width=1 style=square

echo "[+] Loaded yabai config"
