cmd - return : open -a 'Alacritty'
cmd + shift - return : open -na 'Alacritty'
cmd - b : open -a 'Google Chrome'
cmd + shift - b : open -na 'Google Chrome'

cmd + ctrl - f : yabai -m window --toggle zoom-fullscreen
cmd + ctrl + shift - f : yabai -m window --toggle float
cmd + ctrl + shift - p : yabai -m window --toggle sticky

cmd - 1 : yabai -m space --focus 1
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 4 : yabai -m space --focus 4
cmd - 5 : yabai -m space --focus 5
cmd - 6 : yabai -m space --focus 6
cmd - 7 : yabai -m space --focus 7
cmd - 8 : yabai -m space --focus 8
cmd - 9 : yabai -m space --focus 9

cmd + shift - 1 : yabai -m window --space 1
cmd + shift - 2 : yabai -m window --space 2
cmd + shift - 3 : yabai -m window --space 3
cmd + shift - 4 : yabai -m window --space 4
cmd + shift - 5 : yabai -m window --space 5
cmd + shift - 6 : yabai -m window --space 6
cmd + shift - 7 : yabai -m window --space 7
cmd + shift - 8 : yabai -m window --space 8
cmd + shift - 9 : yabai -m window --space 9

cmd + ctrl - n : yabai -m space --focus next || yabai -m space --focus first
cmd + ctrl + shift - n : yabai -m space --focus prev || yabai -m space --focus last

cmd - j : yabai -m window --focus next || yabai -m window --focus first
cmd - k : yabai -m window --focus prev || yabai -m window --focus last

cmd + ctrl + shift - h : yabai -m window --move rel:-40:0
cmd + ctrl + shift - l : yabai -m window --move rel:40:0
cmd + ctrl + shift - j : yabai -m window --move rel:0:40
cmd + ctrl + shift - k : yabai -m window --move rel:0:-40

cmd + ctrl - h : yabai -m window --resize bottom_right:-40:0
cmd + ctrl - l : yabai -m window --resize bottom_right:40:0
cmd + ctrl - j : yabai -m window --resize bottom_right:0:40
cmd + ctrl - k : yabai -m window --resize bottom_right:0:-40
